      "targets": [
        {
          "dataset": "energy_oee",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH parts_hourly AS (\r\n    SELECT\r\n        time_bucket('1 hour', cycle_end_ts) AS bucket_start,\r\n        COUNT(*) FILTER (WHERE part_result = 'good') AS good_parts,\r\n        COUNT(*) FILTER (WHERE part_result = 'scrap') AS scrap_parts\r\n    FROM cycle_event\r\n    WHERE $__timeFilter(cycle_end_ts)\r\n    GROUP BY 1\r\n),\r\nenergy_hourly AS (\r\n    SELECT\r\n        bucket_start,\r\n        SUM(energy_total_kwh) AS energy_total_kwh\r\n    FROM state_energy_summary_hourly\r\n    WHERE $__timeFilter(bucket_start)\r\n    GROUP BY 1\r\n)\r\nSELECT\r\n    COALESCE(p.bucket_start, e.bucket_start) AS \"time\",\r\n    COALESCE(p.good_parts, 0) AS \"Jó darab\",\r\n    COALESCE(p.scrap_parts, 0) AS \"Selejt darab\",\r\n    COALESCE(e.energy_total_kwh, 0) AS \"Összes energia\"\r\nFROM parts_hourly p\r\nFULL OUTER JOIN energy_hourly e\r\n    ON p.bucket_start = e.bucket_start\r\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Óránkénti jó és selejt darabszám, valamint energiafelhasználás",
